{
  "version": 2,
  "name": "copper_smelt_line_v2",
  "description": "Burner mining drill on a copper-ore patch drops ore directly into an adjacent stone furnace; an inserter east of the furnace lifts copper-plate output into a chest. A second inserter pulls plates from the chest onto an east-flowing output belt — the chest is now a 2-stage internal buffer and the module's port is the transport-belt at dx=6.5. Externally fuelled via pre-seeded coal stacks (not self-sustaining beyond the initial fuel load).",
  "anchor": "burner-mining-drill center; worker should place it on a copper-ore patch",
  "entities": [
    {
      "key": "drill",
      "item": "burner-mining-drill",
      "dx": 0,
      "dy": 0,
      "direction": "east",
      "settings": { "fuel": { "item": "coal", "count": 10 } }
    },
    {
      "key": "furnace",
      "item": "stone-furnace",
      "dx": 2,
      "dy": 0,
      "direction": "north",
      "settings": { "fuel": { "item": "coal", "count": 5 } }
    },
    {
      "key": "output_inserter",
      "item": "burner-inserter",
      "dx": 3.5,
      "dy": 0.5,
      "direction": "west",
      "settings": { "fuel": { "item": "coal", "count": 5 } }
    },
    {
      "key": "copper_chest",
      "item": "iron-chest",
      "dx": 4.5,
      "dy": 0.5,
      "direction": "north"
    },
    {
      "key": "output_belt_inserter",
      "item": "burner-inserter",
      "dx": 5.5,
      "dy": 0.5,
      "direction": "west",
      "settings": { "fuel": { "item": "coal", "count": 5 } }
    },
    {
      "key": "output_belt",
      "item": "transport-belt",
      "dx": 6.5,
      "dy": 0.5,
      "direction": "east"
    }
  ],
  "ports": {
    "copper_plate_belt": {
      "entity": "output_belt",
      "kind": "belt",
      "item": "copper-plate"
    }
  },
  "assertions": [
    "worker_selected_anchor_has_copper_ore_context",
    "drill_drops_ore_directly_into_furnace",
    "output_inserter_moves_copper_plate_to_chest",
    "output_belt_inserter_lifts_plates_from_chest_onto_belt"
  ]
}
